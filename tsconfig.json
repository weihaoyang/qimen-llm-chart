{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "*.ts",
    "*.mts",
    ".next-zhiji-check/types/**/*.ts",
    ".next-zhiji-check/dev/types/**/*.ts",
    ".next-verify-kline2/types/**/*.ts",
    ".next-verify-kline2/dev/types/**/*.ts",
    ".next-verify-kline3/types/**/*.ts",
    ".next-verify-kline3/dev/types/**/*.ts",
    ".next-verify-kline4/types/**/*.ts",
    ".next-verify-kline4/dev/types/**/*.ts",
    ".next-verify-kline5/types/**/*.ts",
    ".next-verify-kline5/dev/types/**/*.ts",
    ".next-verify-kline6/types/**/*.ts",
    ".next-verify-kline6/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "vendor",
    "docs"
  ]
}
