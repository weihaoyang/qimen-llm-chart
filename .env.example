OPENAI_API_KEY=your_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Gemini（原生 OpenAI-compatible endpoint；也可替换为 YYRouter）
# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_BASE_URL=https://yyrouter.cc/v1beta
# GEMINI_MODEL=gemini-2.5-flash
NEXT_PUBLIC_PLATFORM_BASE_URL=https://consumer-api.singularitysequence.com
NEXT_PUBLIC_PLATFORM_PRODUCT_CODE=shengtian-banzi
NEXT_PUBLIC_PLATFORM_ACCESS_SCOPE=shengtian-banzi-core
PLATFORM_BASE_URL=https://consumer-api.singularitysequence.com
PLATFORM_PRODUCT_CODE=shengtian-banzi
PLATFORM_ACCESS_SCOPE=shengtian-banzi-core

# HMAC secret for the assessment platform's internal Bazi personality adapter.
# Keep this value server-side; it is not a browser configuration.
BAZI_AGENT_INTERNAL_SECRET=replace-with-a-long-random-secret

# Separate service-to-service key for validated research-rule staging/activation.
# Do not reuse BAZI_AGENT_INTERNAL_SECRET, expose it to browsers, or commit its real value.
BAZI_RESEARCH_INTERNAL_SECRET=replace-with-a-different-long-random-secret

# Product-owned PostgreSQL. Never point this at the Consumer Platform truth database.
DATABASE_URL=postgresql://shengtian_banzi:replace-me@127.0.0.1:5432/shengtian_banzi
DATABASE_POOL_MAX=10
# Set to require only when the database endpoint provides a trusted TLS certificate.
# DATABASE_SSL=require
