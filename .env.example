OPENAI_API_KEY=your_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Gemini（原生 OpenAI-compatible endpoint；也可替换为 YYRouter）
# GEMINI_API_KEY=your_gemini_api_key
# GEMINI_BASE_URL=https://yyrouter.cc/v1beta
# GEMINI_MODEL=gemini-2.5-flash
# Required: actual client_id returned by platform OAuth registration; no product-code fallback.
NEXT_PUBLIC_PLATFORM_OAUTH_CLIENT_ID=8766d44c460e495994ec6f2011cfcbf2
NEXT_PUBLIC_PLATFORM_BASE_URL=https://platform.singseq.com
NEXT_PUBLIC_PLATFORM_PRODUCT_CODE=qimen
NEXT_PUBLIC_PLATFORM_ACCESS_SCOPE=qimen-core
PLATFORM_BASE_URL=https://platform.singseq.com
PLATFORM_PRODUCT_CODE=qimen
PLATFORM_ACCESS_SCOPE=qimen-core
# HMAC secret for the assessment platform's internal Bazi personality adapter.
# Keep this value server-side; it is not a browser configuration.
BAZI_AGENT_INTERNAL_SECRET=replace-with-a-long-random-secret

# Separate service-to-service key for validated research-rule staging/activation.
# Do not reuse BAZI_AGENT_INTERNAL_SECRET, expose it to browsers, or commit its real value.
BAZI_RESEARCH_INTERNAL_SECRET=replace-with-a-different-long-random-secret

# Trusted worker key for writing validated internal connector sync observations.
# Keep this server-side; never expose it to the browser.
QMDJ_CONNECTOR_SYNC_SECRET=replace-with-a-long-random-secret

# Non-sensitive local/release metadata exposed by GET /api/version.
QMDJ_RELEASE_ID=local-dev
QMDJ_RELEASE_COMMIT=working-tree

# Product-owned PostgreSQL. Keep product data separate from platform identity and billing data.
DATABASE_URL=postgresql://shengtian_banzi:replace-me@127.0.0.1:5432/shengtian_banzi
DATABASE_POOL_MAX=10
# Set to require only when the database endpoint provides a trusted TLS certificate.
# DATABASE_SSL=require
